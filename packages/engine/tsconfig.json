{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src"],
  // Unit tests (and their fixture builders) sit next to the source they test; keep them out of dist.
  "exclude": ["src/**/*.test.ts", "src/**/*.fixtures.ts"]
}
