{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The tests run against the packages' source (see vitest.config.ts), so they are typed against it.
    "paths": {
      "@signi/shared": ["../shared/src/index.ts"],
      "@signi/phrase/*": ["../phrase/src/*"],
      "@signi/engine": ["../engine/src/index.ts"]
    },
    // That pulls the engine's source into this program, and the engine does not hold itself to the
    // frontend's unused-declaration lint; `tsc` in the frontend's build still enforces it on src.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src", "test"]
}
